# URL of the analytics service.
# Local development: http://127.0.0.1:8000
# Kubernetes (in-cluster): http://analytics-service:8000
ANALYTICS_SERVICE_URL=http://127.0.0.1:8000

# Web-app auth and database.
DATABASE_URL=postgresql://riskapp:riskapp_secret@localhost:5433/riskscoredb
# Required — must be set before starting the app; missing value causes a startup error.
# Generate with: openssl rand -hex 32
# Never rotate this value while active sessions exist — doing so invalidates all
# existing session cookies and causes JWEDecryptionFailed for every signed-in user.
# To rotate: clear all browser cookies / invalidate all sessions first, then update.
AUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (optional — required to enable GitHub login).
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local/staging admin seed values. Do not commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# kek